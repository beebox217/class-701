rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /records/{recordId} {
      allow read: if request.auth != null
                    && request.auth.token.email != null;

      allow create: if isAdmin() && validRecordPayload(request.resource.data);
      allow update: if isAdmin() && validRecordPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
                       && request.auth.uid == userId
                       && validUserPayload(request.resource.data);

      allow update: if (request.auth != null && request.auth.uid == userId && validUserSelfUpdate(request.resource.data))
                    || (isAdmin() && validUserRoleUpdate(request.resource.data));

      allow delete: if isAdmin();
    }

    match /classInfo/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && validClassInfoPayload(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isAdmin() {
  return request.auth != null
    && request.auth.token.email != null
    && request.auth.token.email.lower() in ['istage.eason@gmail.com'];
}

function validRecordPayload(data) {
  return data.type is string
    && (data.type == 'income' || data.type == 'expense')
    && data.amount is number
    && data.amount > 0
    && data.amount < 10000000
    && data.category is string
    && data.category.size() > 0
    && data.category.size() <= 40
    && data.date is string
    && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
    && (data.note is string || data.note == null)
    && (data.note == null || data.note.size() <= 200)
    && data.classId is string
    && data.classId.size() > 0;
}

function validUserPayload(data) {
  return data.uid is string
    && data.uid.size() > 0
    && (data.email is string || data.email == null)
    && (data.displayName == null || data.displayName is string)
    && (data.role == null || data.role is string)
    && (data.role == null || data.role in ['admin', 'teacher', 'parent'])
    && (data.classId == null || data.classId is string);
}

function validUserSelfUpdate(data) {
  return validUserPayload(data)
    && (data.role == null || data.role in ['teacher', 'parent'])
    && !(data.role == 'admin');
}

function validUserRoleUpdate(data) {
  return (data.uid == null || data.uid is string)
    && (data.role == null || (data.role is string && data.role in ['admin', 'teacher', 'parent']))
    && (data.classId == null || data.classId is string);
}

function validClassInfoPayload(data) {
  return data.classId is string
    && data.classId.size() > 0
    && (data.className == null || data.className is string)
    && (data.students == null || data.students is list)
    && (data.feeItems == null || (data.feeItems is list && validFeeItemsList(data.feeItems)));
}

function validFeeItemsList(list) {
  return list.size() <= 200 && feeItemsAllValid(list, list.size() - 1);
}

function feeItemsAllValid(list, n) {
  return n < 0 || (validFeeItem(list[n]) && feeItemsAllValid(list, n - 1));
}

function validFeeItem(f) {
  return f.name is string
    && f.name.size() > 0
    && f.name.size() <= 40
    && (f.account == null || f.account is string)
    && (f.account == null || f.account.size() <= 100)
    && (f.type == 'income' || f.type == 'expense');
}
